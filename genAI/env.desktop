### nginx ###
NGINX_DOCKER_TAG=stable-alpine-slim
#NGINX_HTTP_DOCKER_PORT=
#NGINX_HTTPS_DOCKER_PORT=
#NGINX_OLLAMA_DOCKER_PORT=
NGINX_REPLICAS=1
NGINX_CPU_LIMIT=1
NGINX_MEM_LIMIT=1

### coredns ###
COREDNS_DOCKER_TAG=latest
#COREDNS_IP=
COREDNS_REPLICAS=1
COREDNS_CPU_LIMIT=1
COREDNS_MEM_LIMIT=1

### openwebui ###
OPENWEBUI_DOCKER_TAG=v0.5.20
#OPENWEBUI_WHISPER_MODEL=
#OPENWEBUI_RAG_EMBEDDING_MODEL=
#OPENWEBUI_REPLICAS=
OPENWEBUI_CPU_LIMIT=4
OPENWEBUI_MEM_LIMIT=4

### libretranslate ###
LIBRETRANSLATE_DOCKER_TAG=v1.6.4
#LIBRETRANSLATE_LANG_SUPPORT=
LIBRETRANSLATE_REPLICAS=1
LIBRETRANSLATE_CPU_LIMIT=4
LIBRETRANSLATE_MEM_LIMIT=4

### ollama ###
OLLAMA_DOCKER_TAG=0.5.13
#OLLAMAWEB_TTY=
#OLLAMAWEB_DEFAULT_MODEL=
OLLAMAWEB_REPLICAS=1
OLLAMAWEB_CPU_LIMIT=8
OLLAMAWEB_MEM_LIMIT=16
#OLLAMAWEB_GPU_LIMIT=
#OLLAMACLI_TTY=
#OLLAMACLI_DEFAULT_MODEL=
OLLAMACLI_REPLICAS=1
OLLAMACLI_CPU_LIMIT=8
OLLAMACLI_MEM_LIMIT=16
#OLLAMACLI_GPU_LIMIT=

### vllm ###
VLLM_DOCKER_TAG=v0.7.3
VLLM_VERS=${VLLM_DOCKER_TAG}
#VLLM_ARCH=cpu
#VLLM_CUDA_VERSION=
#VLLM_CUDA_TORCH_VERSION=
#VLLM_CPU_DISABLE_AVX512=
#VLLM_CPU_AVX512BF16=
#VLLM_API_KEY=
VLLM_MODEL=facebook/opt-125m
#VLLM_TENSOR_PARALLEL=
#VLLM_PIPELINE_PARALLEL=
VLLM_REPLICAS=1
VLLM_CPU_LIMIT=8
VLLM_MEM_LIMIT=16
#VLLM_GPU_LIMIT=
VLLM_CPU_KVCACHE_SPACE=8

### automatic1111 ###
#A1111_DOCKER_TAG=latest-20250111
#A1111_REPLICAS=
#A1111_CPU_LIMIT=
#A1111_MEM_LIMIT=
#A1111_GPU_LIMIT=

### openedaispeech ###
OPENEDAISPEECH_DOCKER_TAG=0.18.2
#OPENEDAISPEECH_API_KEY=
#OPENEDAISPEECH_DEFAULT_VOICE=
OPENEDAISPEECH_REPLICAS=1
OPENEDAISPEECH_CPU_LIMIT=8
OPENEDAISPEECH_MEM_LIMIT=16

### comfyui ###
COMFYUI_DOCKER_TAG=v0.3.23
COMFYUI_VERS=${COMFYUI_DOCKER_TAG}
#COMFYUI_ARCH=cpu
#COMFYUI_CUDA_VERSION=
#COMFYUI_CUDA_TORCH_VERSION=
COMFYUI_REPLICAS=1
COMFYUI_CPU_LIMIT=8
COMFYUI_MEM_LIMIT=16
#COMFYUI_GPU_LIMIT=
COMFYUI_WORKFLOW_MODEL='xxxCOMFYUI_WORKFLOW_MODELxxx'
COMFYUI_WORKFLOW='xxxCOMFYUI_WORKFLOWxxx'

### generic ###
# Note _MEM_LIMIT: needs to be as big as the models for some containers
DOWNLOAD_MEM_LIMIT=8
DOWNLOAD_CPU_LIMIT=2
